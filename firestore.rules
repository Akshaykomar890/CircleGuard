rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /groups/{groupId} {
      function signedIn() {
        return request.auth != null;
      }

      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];

      allow read: if signedIn()
        && resource.data.memberIds.hasAny([request.auth.uid]);

      // Invitation codes are the document IDs. Allowing a direct get lets the
      // client receive an empty snapshot for an invalid code and show a clear
      // validation message instead of a generic permission error.
      allow get: if signedIn();

      allow update: if signedIn()
        && (
          (
            request.resource.data.memberIds.hasAny([request.auth.uid])
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
          )
          ||
          (
            request.resource.data.memberIds == resource.data.memberIds
            && request.resource.data.members.diff(resource.data.members)
              .affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.members[request.auth.uid]
              .diff(resource.data.members[request.auth.uid])
              .affectedKeys().hasOnly(['displayName'])
            && request.resource.data.members[request.auth.uid].displayName is string
          )
        );

      allow delete: if signedIn()
        && resource.data.creatorId == request.auth.uid;

      match /deviceTokens/{userId} {
        allow create, update: if signedIn()
          && userId == request.auth.uid
          && get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds.hasAny([request.auth.uid])
          && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
          && request.resource.data.token is string;

        allow delete: if signedIn() && userId == request.auth.uid;
        allow read: if false;
      }
    }
  }
}
